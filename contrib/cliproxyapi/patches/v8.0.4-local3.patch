diff --git a/sdk/cliproxy/auth/conductor_rate_limit_hold.go b/sdk/cliproxy/auth/conductor_rate_limit_hold.go
new file mode 100644
index 0000000..1b2d54e
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_rate_limit_hold.go
@@ -0,0 +1,332 @@
+package auth
+
+import (
+	"context"
+	"math/rand/v2"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// Rate-limit hold (local patch).
+//
+// Stock behavior turns one upstream 429 into an immediate client error and
+// stores a cooldown as long as the upstream reset hint. OpenCode Zen sends its
+// free-tier window reset (up to ~23h) as Retry-After even on 429s that clear
+// much sooner, so a single 429 parked a single-credential route for most of a
+// day: every later request failed locally without reaching the upstream.
+//
+// Credentials that opt in with rate-limit-hold-seconds instead:
+//   - store 429 cooldowns on a short exponential schedule (2s, 4s, 8s, 15s)
+//     that resets on success; a longer upstream hint is never stored;
+//   - keep a request that ends in 429 connected and re-run its selection and
+//     execution with exponential backoff until the hold window expires, and
+//     only then return the last 429.
+//
+// The hold is model-scoped for opted-in credentials (credential-wide 429
+// propagation is not applied to them). Credentials without the option keep
+// stock behavior, including the long cooldowns other pools rely on.
+
+const rateLimitHoldMaxLevel = 16
+
+// Variables (not constants) only so tests can run the schedule quickly.
+var (
+	rateLimitHoldBackoffBase = 2 * time.Second
+	rateLimitHoldBackoffMax  = 15 * time.Second
+	rateLimitHoldMinCooldown = time.Second
+)
+
+// rateLimitHoldBackoff returns the wait for the given number of consecutive
+// rate-limited probes: 2s, 4s, 8s, then 15s.
+func rateLimitHoldBackoff(level int) time.Duration {
+	wait := rateLimitHoldBackoffBase
+	for i := 0; i < level && wait < rateLimitHoldBackoffMax; i++ {
+		wait *= 2
+	}
+	if wait > rateLimitHoldBackoffMax {
+		wait = rateLimitHoldBackoffMax
+	}
+	return wait
+}
+
+func authRateLimitHoldEnabled(auth *Auth) bool {
+	hold, ok := auth.RateLimitHoldOverride()
+	return ok && hold > 0
+}
+
+func isRateLimitQuotaReason(reason string) bool {
+	switch strings.TrimSpace(reason) {
+	case "quota", "credential_quota":
+		return true
+	default:
+		return false
+	}
+}
+
+// rateLimitHoldCooldownAfterFailure returns the 429 cooldown deadline and the
+// next backoff level for an opted-in credential. A window that a concurrent
+// failure already armed is reused without escalating, unless it outlasts the
+// cap (stale state from an older policy). A shorter upstream hint wins over
+// the schedule; a longer one is ignored.
+func rateLimitHoldCooldownAfterFailure(quota QuotaState, retryAfter *time.Duration, now time.Time) (time.Time, int) {
+	level := quota.BackoffLevel
+	if level < 0 {
+		level = 0
+	}
+	if quota.Exceeded && quota.NextRecoverAt.After(now) && !quota.NextRecoverAt.After(now.Add(rateLimitHoldBackoffMax)) {
+		return quota.NextRecoverAt, level
+	}
+	cooldown := rateLimitHoldBackoff(level)
+	if retryAfter != nil && *retryAfter > 0 && *retryAfter < cooldown {
+		cooldown = *retryAfter
+	}
+	if cooldown < rateLimitHoldMinCooldown {
+		cooldown = rateLimitHoldMinCooldown
+	}
+	if level < rateLimitHoldMaxLevel {
+		level++
+	}
+	return now.Add(cooldown).Round(0), level
+}
+
+// rateLimitHoldCapLimit is the latest deadline a 429 cooldown recorded at
+// recordedAt may keep for an opted-in credential.
+func rateLimitHoldCapLimit(recordedAt, now time.Time) time.Time {
+	if recordedAt.IsZero() || recordedAt.After(now) {
+		recordedAt = now
+	}
+	return recordedAt.Add(rateLimitHoldBackoffMax)
+}
+
+// capRateLimitHoldModelState trims a stored 429 cooldown to the hold cap,
+// anchored at the time the failure was recorded.
+func capRateLimitHoldModelState(state *ModelState, now time.Time) bool {
+	if state == nil || !state.Quota.Exceeded || !isRateLimitQuotaReason(state.Quota.Reason) {
+		return false
+	}
+	limit := rateLimitHoldCapLimit(state.UpdatedAt, now)
+	changed := false
+	if state.NextRetryAfter.After(limit) {
+		state.NextRetryAfter = limit
+		changed = true
+	}
+	if state.Quota.NextRecoverAt.After(limit) {
+		state.Quota.NextRecoverAt = limit
+		changed = true
+	}
+	return changed
+}
+
+// capRateLimitHoldAuthLevel trims an auth-level 429 cooldown to the hold cap.
+// The auth's UpdatedAt moves with every result, so the cap is anchored at now.
+func capRateLimitHoldAuthLevel(auth *Auth, now time.Time) bool {
+	if auth == nil || !auth.Quota.Exceeded || !isRateLimitQuotaReason(auth.Quota.Reason) {
+		return false
+	}
+	limit := now.Add(rateLimitHoldBackoffMax)
+	changed := false
+	if auth.NextRetryAfter.After(limit) {
+		auth.NextRetryAfter = limit
+		changed = true
+	}
+	if auth.Quota.NextRecoverAt.After(limit) {
+		auth.Quota.NextRecoverAt = limit
+		changed = true
+	}
+	return changed
+}
+
+// capRateLimitHoldCooldownsLocked trims every stored 429 cooldown of an
+// opted-in credential. Caller must hold m.mu.
+func capRateLimitHoldCooldownsLocked(auth *Auth, now time.Time) bool {
+	if auth == nil || !authRateLimitHoldEnabled(auth) {
+		return false
+	}
+	changed := capRateLimitHoldAuthLevel(auth, now)
+	for _, state := range auth.ModelStates {
+		if capRateLimitHoldModelState(state, now) {
+			changed = true
+		}
+	}
+	if changed {
+		updateAggregatedAvailability(auth, now)
+		auth.Generation++
+	}
+	return changed
+}
+
+// rateLimitHoldBlockedOnlyByRateLimit reports whether every live block on
+// auth for model is a 429 cooldown the hold may wait out.
+func rateLimitHoldBlockedOnlyByRateLimit(auth *Auth, model string, now time.Time) bool {
+	if auth.Quota.Exceeded && auth.Quota.Reason == "credential_quota" && auth.Quota.NextRecoverAt.After(now) {
+		return true
+	}
+	modelKey := canonicalModelKey(model)
+	matched := false
+	for stateModel, state := range auth.ModelStates {
+		if state == nil || canonicalModelKey(stateModel) != modelKey {
+			continue
+		}
+		matched = true
+		blocked, _, _ := availabilityBlock(state.Unavailable, state.Quota.Exceeded, state.NextRetryAfter, state.Quota.NextRecoverAt, now)
+		if blocked && !(state.Quota.Exceeded && isRateLimitQuotaReason(state.Quota.Reason)) {
+			return false
+		}
+	}
+	if matched {
+		return true
+	}
+	return auth.Quota.Exceeded && isRateLimitQuotaReason(auth.Quota.Reason)
+}
+
+// rateLimitHoldPlan reports whether a request for model may be held after a
+// 429. At least one opted-in candidate must be available or blocked only by a
+// 429 cooldown. It returns the longest hold window among those candidates and
+// the earliest time one of them can be probed again. Stale 429 deadlines past
+// the cap are trimmed first, so state restored or reloaded under an older
+// policy cannot outlast the hold.
+func (m *Manager) rateLimitHoldPlan(ctx context.Context, opts cliproxyexecutor.Options, providers []string, model string, now time.Time) (time.Duration, time.Time, bool) {
+	if m == nil || len(providers) == 0 || m.HomeEnabled() {
+		return 0, time.Time{}, false
+	}
+	providerSet := make(map[string]struct{}, len(providers))
+	for i := range providers {
+		if key := strings.TrimSpace(strings.ToLower(providers[i])); key != "" {
+			providerSet[key] = struct{}{}
+		}
+	}
+	eligibility := authSelectionEligibilityForRequest(ctx, opts)
+	pinnedAuthID := pinnedAuthIDFromMetadata(opts.Metadata)
+	registryRef := registry.GetGlobalRegistry()
+
+	var (
+		window  time.Duration
+		readyAt time.Time
+		found   bool
+		trimmed []*Auth
+	)
+	m.mu.Lock()
+	for _, auth := range m.auths {
+		if auth == nil || auth.Disabled || auth.Status == StatusDisabled {
+			continue
+		}
+		hold, ok := auth.RateLimitHoldOverride()
+		if !ok || hold <= 0 {
+			continue
+		}
+		if pinnedAuthID != "" && auth.ID != pinnedAuthID {
+			continue
+		}
+		if !eligibility.allows(auth) {
+			continue
+		}
+		if _, ok := providerSet[executorKeyFromAuth(auth)]; !ok {
+			continue
+		}
+		if model != "" && !m.authSupportsRouteModel(registryRef, auth, model) {
+			continue
+		}
+		if capRateLimitHoldCooldownsLocked(auth, now) {
+			trimmed = append(trimmed, auth.Clone())
+		}
+		checkModel := model
+		if strings.TrimSpace(model) != "" {
+			checkModel = m.selectionModelForAuth(auth, model)
+		}
+		candidateReady := now
+		if blocked, reason, next := isAuthBlockedForModel(auth, checkModel, now); blocked {
+			if reason != blockReasonCooldown || next.IsZero() || !rateLimitHoldBlockedOnlyByRateLimit(auth, checkModel, now) {
+				continue
+			}
+			candidateReady = next
+		}
+		if !found || candidateReady.Before(readyAt) {
+			readyAt = candidateReady
+		}
+		if hold > window {
+			window = hold
+		}
+		found = true
+	}
+	m.mu.Unlock()
+	if m.scheduler != nil {
+		for _, snapshot := range trimmed {
+			m.scheduler.upsertAuth(snapshot)
+		}
+	}
+	return window, readyAt, found
+}
+
+// isRateLimitHoldError reports whether err is a 429 the hold may wait out.
+// Request-scoped refusals (for example Claude fast-mode credits) and request
+// stops are returned to the client unchanged.
+func isRateLimitHoldError(err error) bool {
+	if err == nil || statusCodeFromError(err) != http.StatusTooManyRequests {
+		return false
+	}
+	return !isRequestInvalidError(err) && !isRequestStopError(err) && !isRequestScopedError(err) && !isRequestTerminatedError(err)
+}
+
+func rateLimitHoldJitter(wait time.Duration) time.Duration {
+	spread := wait / 10
+	if spread <= 0 {
+		return wait
+	}
+	return wait + rand.N(spread)
+}
+
+// runWithRateLimitHold runs attempt and re-runs it while it fails with a 429
+// that an opted-in credential may still recover from inside its hold window.
+// Waits grow exponentially (2s .. 15s), never end before the earliest probe
+// time of a cooling candidate, and stop at the window end, where the last
+// attempt's error is returned unchanged. Client cancellation ends the hold.
+func (m *Manager) runWithRateLimitHold(ctx context.Context, opts cliproxyexecutor.Options, providers []string, model string, attempt func() error) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	var holdStart time.Time
+	for step := 0; ; step++ {
+		err := attempt()
+		if err == nil {
+			if !holdStart.IsZero() {
+				logEntryWithRequestID(ctx).Infof("rate-limit hold recovered: model=%s held=%s attempts=%d", model, time.Since(holdStart).Round(time.Millisecond), step+1)
+			}
+			return nil
+		}
+		if !isRateLimitHoldError(err) || ctx.Err() != nil {
+			return err
+		}
+		now := time.Now()
+		window, readyAt, ok := m.rateLimitHoldPlan(ctx, opts, providers, model, now)
+		if !ok {
+			return err
+		}
+		if holdStart.IsZero() {
+			holdStart = now
+		}
+		remaining := holdStart.Add(window).Sub(now)
+		if remaining <= 0 {
+			logEntryWithRequestID(ctx).Warnf("rate-limit hold exhausted: model=%s held=%s attempts=%d", model, now.Sub(holdStart).Round(time.Millisecond), step+1)
+			return err
+		}
+		wait := rateLimitHoldBackoff(step)
+		if untilReady := readyAt.Sub(now); untilReady > wait {
+			wait = untilReady
+		}
+		wait = rateLimitHoldJitter(wait)
+		if wait > remaining {
+			wait = remaining
+		}
+		logEntryWithRequestID(ctx).Infof("rate-limit hold: model=%s attempt=%d wait=%s remaining=%s", model, step+1, wait.Round(time.Millisecond), remaining.Round(time.Second))
+		timer := time.NewTimer(wait)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
diff --git a/sdk/cliproxy/auth/conductor_rate_limit_hold_test.go b/sdk/cliproxy/auth/conductor_rate_limit_hold_test.go
new file mode 100644
index 0000000..5d107d9
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_rate_limit_hold_test.go
@@ -0,0 +1,396 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// zenDailyRetryAfter is the Retry-After OpenCode Zen sent with a 429 on
+// 2026-10-22 (remaining free-tier day) although the limit cleared sooner.
+const zenDailyRetryAfter = 81927 * time.Second
+
+type holdRateLimitError struct {
+	retryAfter time.Duration
+}
+
+func (e holdRateLimitError) Error() string {
+	return `{"error":{"message":"Rate limit exceeded. Please try again later.","type":"rate_limit_error"},"type":"error"}`
+}
+
+func (holdRateLimitError) StatusCode() int { return http.StatusTooManyRequests }
+
+func (e holdRateLimitError) RetryAfter() *time.Duration {
+	value := e.retryAfter
+	return &value
+}
+
+type holdRequestScopedError struct{ holdRateLimitError }
+
+func (holdRequestScopedError) IsRequestScoped() bool { return true }
+
+// holdScriptExecutor fails the first failFirst calls with err (all calls when
+// failFirst < 0) and succeeds afterwards. bootstrap delivers stream failures
+// in the first chunk instead of as a synchronous error.
+type holdScriptExecutor struct {
+	identifier string
+	failFirst  int
+	err        error
+	bootstrap  bool
+
+	mu    sync.Mutex
+	calls []time.Time
+}
+
+func (e *holdScriptExecutor) Identifier() string { return e.identifier }
+
+func (e *holdScriptExecutor) next() error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.calls = append(e.calls, time.Now())
+	if e.failFirst < 0 || len(e.calls) <= e.failFirst {
+		return e.err
+	}
+	return nil
+}
+
+func (e *holdScriptExecutor) callCount() int {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return len(e.calls)
+}
+
+func (e *holdScriptExecutor) Execute(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := e.next(); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	return cliproxyexecutor.Response{Payload: []byte(`{"ok":true}`)}, nil
+}
+
+func (e *holdScriptExecutor) ExecuteStream(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	err := e.next()
+	if err != nil && !e.bootstrap {
+		return nil, err
+	}
+	ch := make(chan cliproxyexecutor.StreamChunk, 1)
+	if err != nil {
+		ch <- cliproxyexecutor.StreamChunk{Err: err}
+	} else {
+		ch <- cliproxyexecutor.StreamChunk{Payload: []byte("data: ok\n\n")}
+	}
+	close(ch)
+	return &cliproxyexecutor.StreamResult{Chunks: ch}, nil
+}
+
+func (*holdScriptExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) { return auth, nil }
+
+func (e *holdScriptExecutor) CountTokens(ctx context.Context, auth *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(ctx, auth, req, opts)
+}
+
+func (*holdScriptExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func fastRateLimitHoldSchedule(t *testing.T) {
+	t.Helper()
+	base, maxWait, minCooldown := rateLimitHoldBackoffBase, rateLimitHoldBackoffMax, rateLimitHoldMinCooldown
+	rateLimitHoldBackoffBase = 20 * time.Millisecond
+	rateLimitHoldBackoffMax = 100 * time.Millisecond
+	rateLimitHoldMinCooldown = 10 * time.Millisecond
+	t.Cleanup(func() {
+		rateLimitHoldBackoffBase, rateLimitHoldBackoffMax, rateLimitHoldMinCooldown = base, maxWait, minCooldown
+	})
+}
+
+// newHoldManager mirrors the live CPA settings for the oc route: one
+// credential, request-retry 1, no max-retry-interval.
+func newHoldManager(t *testing.T, executor *holdScriptExecutor, holdSeconds int) *Manager {
+	t.Helper()
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(1, 0, 8)
+	manager.RegisterExecutor(executor)
+	authID := executor.identifier + "-auth"
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient(authID, executor.identifier, []*registry.ModelInfo{{ID: "hold-model"}})
+	t.Cleanup(func() { reg.UnregisterClient(authID) })
+	metadata := map[string]any{}
+	if holdSeconds > 0 {
+		metadata["rate_limit_hold_seconds"] = holdSeconds
+	}
+	if _, errRegister := manager.Register(context.Background(), &Auth{ID: authID, Provider: executor.identifier, Metadata: metadata}); errRegister != nil {
+		t.Fatalf("register: %v", errRegister)
+	}
+	return manager
+}
+
+type holdInvoke struct {
+	name string
+	run  func(context.Context, *Manager, string) error
+}
+
+func holdInvocations() []holdInvoke {
+	req := cliproxyexecutor.Request{Model: "hold-model"}
+	return []holdInvoke{
+		{"execute", func(ctx context.Context, m *Manager, provider string) error {
+			_, err := m.Execute(ctx, []string{provider}, req, cliproxyexecutor.Options{})
+			return err
+		}},
+		{"count", func(ctx context.Context, m *Manager, provider string) error {
+			_, err := m.ExecuteCount(ctx, []string{provider}, req, cliproxyexecutor.Options{})
+			return err
+		}},
+		{"stream", func(ctx context.Context, m *Manager, provider string) error {
+			result, err := m.ExecuteStream(ctx, []string{provider}, req, cliproxyexecutor.Options{Stream: true})
+			if err != nil {
+				return err
+			}
+			for chunk := range result.Chunks {
+				if chunk.Err != nil {
+					return chunk.Err
+				}
+			}
+			return nil
+		}},
+	}
+}
+
+func TestRateLimitHoldBackoffSchedule(t *testing.T) {
+	want := []time.Duration{2 * time.Second, 4 * time.Second, 8 * time.Second, 15 * time.Second, 15 * time.Second}
+	for level, expected := range want {
+		if got := rateLimitHoldBackoff(level); got != expected {
+			t.Fatalf("level %d: got %s, want %s", level, got, expected)
+		}
+	}
+	if got := rateLimitHoldBackoff(1 << 20); got != 15*time.Second {
+		t.Fatalf("huge level must stay capped, got %s", got)
+	}
+}
+
+func TestRateLimitHoldRecoversWithinWindow(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	for _, invoke := range holdInvocations() {
+		for _, bootstrap := range []bool{false, true} {
+			if bootstrap && invoke.name != "stream" {
+				continue
+			}
+			t.Run(invoke.name, func(t *testing.T) {
+				executor := &holdScriptExecutor{identifier: "hold-recover-" + invoke.name, failFirst: 4, err: holdRateLimitError{retryAfter: zenDailyRetryAfter}, bootstrap: bootstrap}
+				manager := newHoldManager(t, executor, 5)
+				start := time.Now()
+				if err := invoke.run(context.Background(), manager, executor.identifier); err != nil {
+					t.Fatalf("held request must recover, got %v", err)
+				}
+				if calls := executor.callCount(); calls != 5 {
+					t.Fatalf("upstream calls = %d, want 4 rate-limited probes + 1 success", calls)
+				}
+				if elapsed := time.Since(start); elapsed > 3*time.Second {
+					t.Fatalf("recovery took %s; the 22h Retry-After must not be waited out", elapsed)
+				}
+				// The success cleared the cooldown: the next request goes straight through.
+				before := executor.callCount()
+				start = time.Now()
+				if err := invoke.run(context.Background(), manager, executor.identifier); err != nil {
+					t.Fatalf("request after recovery failed: %v", err)
+				}
+				if executor.callCount() != before+1 || time.Since(start) > 500*time.Millisecond {
+					t.Fatal("request after recovery was delayed or retried")
+				}
+			})
+		}
+	}
+}
+
+func TestRateLimitHoldExhaustsAfterWindow(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	for _, invoke := range holdInvocations() {
+		t.Run(invoke.name, func(t *testing.T) {
+			executor := &holdScriptExecutor{identifier: "hold-exhaust-" + invoke.name, failFirst: -1, err: holdRateLimitError{retryAfter: zenDailyRetryAfter}, bootstrap: invoke.name == "stream"}
+			manager := newHoldManager(t, executor, 1)
+			start := time.Now()
+			err := invoke.run(context.Background(), manager, executor.identifier)
+			elapsed := time.Since(start)
+			if statusCodeFromError(err) != http.StatusTooManyRequests {
+				t.Fatalf("want 429 after the hold, got %v", err)
+			}
+			if elapsed < 950*time.Millisecond || elapsed > 2500*time.Millisecond {
+				t.Fatalf("hold lasted %s, want about the 1s window", elapsed)
+			}
+			// Exponential probes (20ms .. 100ms) across the window, not one call
+			// and not a hot loop.
+			if calls := executor.callCount(); calls < 6 || calls > 30 {
+				t.Fatalf("upstream calls = %d during a 1s hold", calls)
+			}
+		})
+	}
+}
+
+func TestRateLimitHoldNotAppliedToStockCredential(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	executor := &holdScriptExecutor{identifier: "hold-stock", failFirst: -1, err: holdRateLimitError{retryAfter: zenDailyRetryAfter}}
+	manager := newHoldManager(t, executor, 0)
+	start := time.Now()
+	_, err := manager.Execute(context.Background(), []string{executor.identifier}, cliproxyexecutor.Request{Model: "hold-model"}, cliproxyexecutor.Options{})
+	if statusCodeFromError(err) != http.StatusTooManyRequests || time.Since(start) > 500*time.Millisecond || executor.callCount() != 1 {
+		t.Fatalf("stock credential must fail fast with one call: err=%v calls=%d", err, executor.callCount())
+	}
+	auth, _ := manager.GetByID(executor.identifier + "-auth")
+	state := auth.ModelStates["hold-model"]
+	if state == nil || state.NextRetryAfter.Before(time.Now().Add(zenDailyRetryAfter-time.Minute)) {
+		t.Fatalf("stock credential must keep the upstream cooldown, got %+v", state)
+	}
+}
+
+func TestRateLimitHoldSkipsRequestScoped429(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	executor := &holdScriptExecutor{identifier: "hold-scoped", failFirst: -1, err: holdRequestScopedError{holdRateLimitError{retryAfter: time.Minute}}}
+	manager := newHoldManager(t, executor, 5)
+	start := time.Now()
+	_, err := manager.Execute(context.Background(), []string{executor.identifier}, cliproxyexecutor.Request{Model: "hold-model"}, cliproxyexecutor.Options{})
+	if err == nil || time.Since(start) > 500*time.Millisecond || executor.callCount() != 1 {
+		t.Fatalf("request-scoped 429 must not be held: err=%v calls=%d", err, executor.callCount())
+	}
+}
+
+func TestRateLimitHoldStopsOnClientCancel(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	executor := &holdScriptExecutor{identifier: "hold-cancel", failFirst: -1, err: holdRateLimitError{retryAfter: zenDailyRetryAfter}}
+	manager := newHoldManager(t, executor, 60)
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_, err := manager.Execute(ctx, []string{executor.identifier}, cliproxyexecutor.Request{Model: "hold-model"}, cliproxyexecutor.Options{})
+	if !errors.Is(err, context.DeadlineExceeded) || time.Since(start) > time.Second {
+		t.Fatalf("client cancellation must end the hold: err=%v elapsed=%s", err, time.Since(start))
+	}
+}
+
+func TestRateLimitHoldCooldownIgnoresLongUpstreamHint(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	auth := &Auth{ID: "hold-mark", Provider: "claude", Metadata: map[string]any{"rate_limit_hold_seconds": 180}}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+	// A deadline left by an older policy must not survive the next 429.
+	manager.mu.Lock()
+	stale := ensureModelState(manager.auths[auth.ID], "deepseek-v4.1-flash-oc")
+	stale.NextRetryAfter = time.Now().Add(22 * time.Hour)
+	manager.mu.Unlock()
+
+	retryAfter := zenDailyRetryAfter
+	fail := func() *ModelState {
+		manager.MarkResult(context.Background(), Result{
+			AuthID: auth.ID, Provider: "claude", Model: "deepseek-v4.1-flash-oc", Success: false,
+			RetryAfter: &retryAfter, Error: &Error{HTTPStatus: http.StatusTooManyRequests, Message: "rate limit"},
+		})
+		current, _ := manager.GetByID(auth.ID)
+		return current.ModelStates["deepseek-v4.1-flash-oc"]
+	}
+	state := fail()
+	if until := time.Until(state.NextRetryAfter); until <= 0 || until > 2*time.Second || time.Until(state.Quota.NextRecoverAt) > 2*time.Second {
+		t.Fatalf("first 429 must cool for the 2s step, got retry=%s recover=%s", until, time.Until(state.Quota.NextRecoverAt))
+	}
+	if state.Quota.BackoffLevel != 1 {
+		t.Fatalf("backoff level = %d, want 1", state.Quota.BackoffLevel)
+	}
+	first := state.NextRetryAfter
+	if concurrent := fail(); !concurrent.NextRetryAfter.Equal(first) || concurrent.Quota.BackoffLevel != 1 {
+		t.Fatal("a concurrent failure inside the window must not extend or escalate it")
+	}
+
+	// After the window passes the next failure escalates to the 4s step.
+	manager.mu.Lock()
+	expired := manager.auths[auth.ID].ModelStates["deepseek-v4.1-flash-oc"]
+	expired.NextRetryAfter = time.Now().Add(-time.Second)
+	expired.Quota.NextRecoverAt = expired.NextRetryAfter
+	manager.mu.Unlock()
+	state = fail()
+	if until := time.Until(state.NextRetryAfter); until <= 2*time.Second || until > 4*time.Second || state.Quota.BackoffLevel != 2 {
+		t.Fatalf("second window = %s level %d, want the 4s step", until, state.Quota.BackoffLevel)
+	}
+
+	manager.MarkResult(context.Background(), Result{AuthID: auth.ID, Provider: "claude", Model: "deepseek-v4.1-flash-oc", Success: true})
+	current, _ := manager.GetByID(auth.ID)
+	if recovered := current.ModelStates["deepseek-v4.1-flash-oc"]; recovered.Unavailable || recovered.Quota.Exceeded || recovered.Quota.BackoffLevel != 0 {
+		t.Fatalf("success must clear the hold cooldown, got %+v", recovered)
+	}
+}
+
+func TestRateLimitHoldCapsPersistedCooldownOnRestore(t *testing.T) {
+	now := time.Now()
+	record := func(model string, updatedAt time.Time) CooldownStateRecord {
+		next := now.Add(22*time.Hour + 45*time.Minute)
+		return CooldownStateRecord{
+			Provider: "claude", AuthID: "hold-restore", Model: model, Status: "cooling",
+			NextRetryAfter: next, Reason: "quota",
+			Quota:     QuotaState{Exceeded: true, Reason: "quota", NextRecoverAt: next},
+			LastError: &Error{HTTPStatus: http.StatusTooManyRequests, Message: "rate limit"},
+			UpdatedAt: updatedAt,
+		}
+	}
+	for _, hold := range []int{180, 0} {
+		manager := NewManager(nil, nil, nil)
+		metadata := map[string]any{}
+		if hold > 0 {
+			metadata["rate_limit_hold_seconds"] = hold
+		}
+		if _, err := manager.Register(context.Background(), &Auth{ID: "hold-restore", Provider: "claude", Metadata: metadata}); err != nil {
+			t.Fatalf("register: %v", err)
+		}
+		manager.SetCooldownStateStore(&mockCooldownStateStore{records: []CooldownStateRecord{
+			record("old-model", now.Add(-10*time.Minute)),
+			record("recent-model", now.Add(-5*time.Second)),
+		}})
+		if err := manager.RestoreCooldownStates(context.Background()); err != nil {
+			t.Fatalf("restore: %v", err)
+		}
+		auth, _ := manager.GetByID("hold-restore")
+		oldBlocked, _, _ := isAuthBlockedForModel(auth, "old-model", time.Now())
+		recentBlocked, _, recentNext := isAuthBlockedForModel(auth, "recent-model", time.Now())
+		if hold == 0 {
+			if !oldBlocked || !recentBlocked || time.Until(recentNext) < 22*time.Hour {
+				t.Fatal("stock credentials must restore persisted cooldowns unchanged")
+			}
+			continue
+		}
+		if oldBlocked {
+			t.Fatal("a persisted 22h 429 cooldown from 10 minutes ago must not block a hold credential")
+		}
+		if !recentBlocked || time.Until(recentNext) > rateLimitHoldBackoffMax {
+			t.Fatalf("a recent 429 must be restored capped to its hold window, got blocked=%t next=%s", recentBlocked, time.Until(recentNext))
+		}
+	}
+}
+
+func TestRateLimitHoldPlanTrimsStaleCooldown(t *testing.T) {
+	fastRateLimitHoldSchedule(t)
+	executor := &holdScriptExecutor{identifier: "hold-stale", failFirst: 0}
+	manager := newHoldManager(t, executor, 2)
+	authID := executor.identifier + "-auth"
+	// Simulates a 22h deadline loaded before this credential opted in (hot
+	// reload): the first request must probe instead of failing locally.
+	manager.mu.Lock()
+	state := ensureModelState(manager.auths[authID], "hold-model")
+	state.Unavailable = true
+	state.Status = StatusError
+	state.NextRetryAfter = time.Now().Add(22 * time.Hour)
+	state.UpdatedAt = time.Now().Add(-time.Hour)
+	applyCooldownFields(&state.Quota, QuotaState{Exceeded: true, Reason: "quota", NextRecoverAt: state.NextRetryAfter})
+	updateAggregatedAvailability(manager.auths[authID], time.Now())
+	snapshot := manager.auths[authID].Clone()
+	manager.mu.Unlock()
+	manager.scheduler.upsertAuth(snapshot)
+
+	if _, err := manager.Execute(context.Background(), []string{executor.identifier}, cliproxyexecutor.Request{Model: "hold-model"}, cliproxyexecutor.Options{}); err != nil {
+		t.Fatalf("stale cooldown must be trimmed and the upstream probed, got %v", err)
+	}
+	if executor.callCount() != 1 {
+		t.Fatalf("upstream calls = %d, want 1", executor.callCount())
+	}
+}
diff --git a/sdk/cliproxy/auth/conductor_refresh.go b/sdk/cliproxy/auth/conductor_refresh.go
index 4bf7fd1..b370053 100644
--- a/sdk/cliproxy/auth/conductor_refresh.go
+++ b/sdk/cliproxy/auth/conductor_refresh.go
@@ -164,7 +164,12 @@ func (m *Manager) shouldRefresh(a *Auth, now time.Time) bool {
 		return false
 	}
 	if hasExpiry && !expiry.IsZero() {
-		return time.Until(expiry) <= *lead
+		// Stagger due time across the lead window so large pools don't stampede.
+		effectiveLead := *lead - refreshStaggerOffset(a, *lead)
+		if effectiveLead < 0 {
+			effectiveLead = 0
+		}
+		return time.Until(expiry) <= effectiveLead
 	}
 	if !lastRefresh.IsZero() {
 		return now.Sub(lastRefresh) >= *lead
@@ -172,6 +177,34 @@ func (m *Manager) shouldRefresh(a *Auth, now time.Time) bool {
 	return true
 }
 
+// refreshStaggerOffset returns a deterministic offset in [0, lead) derived from
+// the auth identity so refresh work for large pools is spread across the lead window.
+func refreshStaggerOffset(auth *Auth, lead time.Duration) time.Duration {
+	if auth == nil || lead <= 0 {
+		return 0
+	}
+	id := strings.TrimSpace(auth.ID)
+	if id == "" {
+		id = strings.TrimSpace(auth.FileName)
+	}
+	if id == "" {
