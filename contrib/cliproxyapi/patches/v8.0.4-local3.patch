@@ -0,0 +1,54 @@
+package synthesizer
+
+import (
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+// The live opencode-cc route is a v8 api-keys.claude group; the hold window is
+// set at group level next to prefix/models and must reach the synthesized auth.
+func TestConfigSynthesizerClaudeRateLimitHoldFromV8Group(t *testing.T) {
+	cfg, errParse := config.ParseConfigBytes([]byte(`
+config-version: 8
+api-keys:
+  claude:
+    - name: claude-2
+      base-url: http://localhost:8787
+      prefix: oc
+      rate-limit-hold-seconds: 180
+      keys:
+        - api-key: fixture
+          models:
+            - name: deepseek-v4.1-flash-free
+              alias: deepseek-v4.1-flash-oc
+    - name: claude-3
+      base-url: http://localhost:8789
+      keys:
+        - api-key: fixture-2
+`))
+	if errParse != nil {
+		t.Fatalf("parse v8 config: %v", errParse)
+	}
+	if len(cfg.ClaudeKey) != 2 || cfg.ClaudeKey[0].RateLimitHoldSeconds == nil || *cfg.ClaudeKey[0].RateLimitHoldSeconds != 180 {
+		t.Fatalf("claude[0].rate-limit-hold-seconds not parsed: %+v", cfg.ClaudeKey)
+	}
+	if cfg.ClaudeKey[1].RateLimitHoldSeconds != nil {
+		t.Fatal("claude[1] must keep the stock policy")
+	}
+	auths, errSynthesize := NewConfigSynthesizer().Synthesize(&SynthesisContext{
+		Config:      cfg,
+		Now:         time.Unix(100, 0).UTC(),
+		IDGenerator: NewStableIDGenerator(),
+	})
+	if errSynthesize != nil || len(auths) != 2 {
+		t.Fatalf("synthesize: auths=%d err=%v", len(auths), errSynthesize)
+	}
+	if hold, ok := auths[0].RateLimitHoldOverride(); !ok || hold != 180*time.Second {
+		t.Fatalf("hold credential override = %s/%t, want 180s", hold, ok)
+	}
+	if _, ok := auths[1].RateLimitHoldOverride(); ok {
+		t.Fatal("stock credential must not get a hold override")
+	}
+}
