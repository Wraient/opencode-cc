+// RateLimitHoldOverride returns the per-credential rate-limit hold window.
+// The value is read from metadata key "rate_limit_hold_seconds" (or legacy
+// "rate-limit-hold-seconds"); unset or non-positive values disable the hold.
+func (a *Auth) RateLimitHoldOverride() (time.Duration, bool) {
+	if a == nil || a.Metadata == nil {
+		return 0, false
+	}
+	for _, key := range []string{"rate_limit_hold_seconds", "rate-limit-hold-seconds"} {
+		if val, ok := a.Metadata[key]; ok {
+			if parsed, okParse := parseIntAny(val); okParse && parsed > 0 {
+				return time.Duration(parsed) * time.Second, true
+			}
+			return 0, false
+		}
+	}
+	return 0, false
+}
