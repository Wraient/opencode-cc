# Copy privately to ~/.config/telegram-ip-reset.env, chmod 600.
TELEGRAM_IP_RESET_BOT_TOKEN='REPLACE_WITH_YOUR_BOT_TOKEN'
TELEGRAM_IP_RESET_CHAT_ID='REPLACE_WITH_YOUR_PRIVATE_CHAT_ID'
TELEGRAM_IP_RESET_TEXT='network-reset'
TELEGRAM_IP_RESET_PROXY='http://127.0.0.1:18889'
TELEGRAM_IP_RESET_TIMEOUT=180
# Optional: delete only the bot's sent trigger after recovery.
# TELEGRAM_IP_RESET_DELETE_AFTER=5
